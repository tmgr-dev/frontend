{
	"id": "yourname.hello",
	"name": "Hello",
	"version": "1.0.0",
	"publisher": "yourname",
	"description": "Shows how many tasks are in progress.",
	"engines": { "tmgr": "^1.0" },
	"main": "main.js",
	"permissions": ["tasks:read", "statuses:read"],
	"contributes": {
		"statusBarItems": [{ "id": "count" }],
		"commands": [{ "id": "yourname.hello.refresh", "title": "Count tasks in progress" }],
		"views": [
			{ "id": "summary", "title": "Hello summary" },
			{ "id": "page", "title": "Hello page", "ui": "ui/page.html" }
		]
	}
}
