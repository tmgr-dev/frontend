{
	"id": "tmgr-dev.kitchen-sink",
	"name": "Kitchen Sink",
	"version": "1.0.0",
	"publisher": "tmgr-dev",
	"description": "Exercises every plugin API v1.6 feature, for manual acceptance testing.",
	"engines": { "tmgr": "^1.6" },
	"main": "main.js",
	"permissions": [
		"tasks:read",
		"tasks:write",
		"statuses:read",
		"statuses:write",
		"categories:read",
		"categories:write",
		"comments:write",
		"relations:write",
		"agent_work:read",
		"agent_work:write",
		"routines:read",
		"routines:write",
		"alarms",
		"notifications",
		"tray",
		"deeplinks",
		"links:open",
		"views:badge",
		"pages:read",
		"pages:write",
		"pages:sections",
		"menus:task"
	],
	"links": { "allowedDomains": ["example.com"] },
	"contributes": {
		"boardCardBadges": [{ "id": "ks-badges" }],
		"statusBarItems": [{ "id": "count" }],
		"trayItems": [{ "id": "ks-tray" }],
		"commands": [
			{ "id": "tmgr-dev.kitchen-sink.setup", "title": "Set up workspace" },
			{ "id": "tmgr-dev.kitchen-sink.createSample", "title": "Create sample task" },
			{ "id": "tmgr-dev.kitchen-sink.sayHi", "title": "Say hi (from a task section button)" },
			{ "id": "tmgr-dev.kitchen-sink.ping", "title": "Ping Kitchen Sink", "deepLink": true },
			{ "id": "tmgr-dev.kitchen-sink.captureNotes", "title": "Capture today's notes" },
			{ "id": "tmgr-dev.kitchen-sink.writePage", "title": "Write a Kitchen Sink page" },
			{ "id": "tmgr-dev.kitchen-sink.cardClicked", "title": "Kitchen Sink card clicked (demo)" },
			{ "id": "tmgr-dev.kitchen-sink.commentOnTask", "title": "Add a Kitchen Sink comment" },
			{ "id": "tmgr-dev.kitchen-sink.notifyTask", "title": "Show task id" }
		],
		"menus": {
			"task/card": [
				{ "command": "tmgr-dev.kitchen-sink.commentOnTask", "title": "Add a Kitchen Sink comment" },
				{ "command": "tmgr-dev.kitchen-sink.notifyTask", "title": "Show task id" }
			]
		},
		"views": [
			{ "id": "view", "title": "Kitchen Sink view" },
			{ "id": "window", "title": "Kitchen Sink window", "ui": "ui/page.html" }
		],
		"taskPanelSections": [{ "id": "ks-section", "title": "Kitchen Sink" }],
		"boardFilters": [
			{ "id": "ks-touched", "title": "Touched by Kitchen Sink", "badge": "ks-badges", "key": "kitchen-sink" }
		]
	}
}
