server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    server_name _;
    charset utf-8;

    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/markdown text/plain text/css application/javascript application/json application/manifest+json image/svg+xml font/ttf application/xml;

    # Hashed build output: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Entry points the PWA / browser must always revalidate.
    location = /index.html { add_header Cache-Control "no-cache"; }
    location = /sw.js { add_header Cache-Control "no-cache"; }
    location = /install.sh { add_header Cache-Control "no-cache"; }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location = /docs/plugins.md {
        types { }
        default_type "text/markdown; charset=utf-8";
        try_files $uri =404;
    }
    location ~ ^/docs/plugin-sdk/.+\.(d\.ts|md)$ {
        types { }
        default_type "text/plain; charset=utf-8";
        try_files $uri =404;
    }

    # Docs pages are prerendered to docs/**/index.html; a file check (not $uri/) avoids slash redirects.
    location = /docs {
        add_header Cache-Control "no-cache";
        try_files /docs/index.html /index.html;
    }
    location /docs/ {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/index.html /index.html;
    }

    location = /sitemap.xml {
        types { }
        default_type application/xml;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /.well-known/apple-app-site-association {
        default_type application/json;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # Pairing page: static, tracker-free; the URL fragment is a one-time secret. Never fall back to the SPA.
    location ^~ /pair {
        try_files /pair.html =404;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'sha256-q6IS4R7e/kNp62+rAEFVK0evsN9cqSi2uxBzUKB90OA='; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    }
    location = /pair.html { return 404; }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    access_log off;
    error_log  /var/log/nginx/error.log error;
    sendfile off;

    location ~ /\.ht { deny all; }
}
