	"description": "Task Manager. Take under control your life.",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/precompress.mjs",
		"preview": "vite preview",
