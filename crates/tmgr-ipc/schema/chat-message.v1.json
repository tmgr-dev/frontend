{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schema/chat-message.v1.json",
  "title": "TMGR manager chat message (chat.v1)",
  "type": "object",
  "required": ["v", "id", "room", "author", "ts_ms", "kind", "body_md"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "pattern": "^m_[0-9a-f]{32}$" },
    "room": {
      "type": "object",
      "required": ["kind", "machine"],
      "properties": {
        "kind": { "enum": ["manager", "session"] },
        "machine": { "$ref": "#/$defs/token" },
        "session": { "$ref": "#/$defs/token" }
      }
    },
    "author": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["owner", "manager", "session", "system"] },
        "id": { "$ref": "#/$defs/token" },
        "machine": { "$ref": "#/$defs/token" },
        "device": { "$ref": "#/$defs/token" },
        "agent": { "$ref": "#/$defs/token" }
      }
    },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "kind": {
      "description": "Readers render an unknown kind like system.",
      "type": "string",
      "examples": ["text", "decision", "system"]
    },
    "body_md": { "type": "string", "maxLength": 65536 },
    "attachments": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["name", "mime", "size", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "mime": { "type": "string", "minLength": 1, "maxLength": 255 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "reply_to": { "type": "string", "pattern": "^m_[0-9a-f]{32}$" },
    "decision": {
      "type": "object",
      "required": ["card_id"],
      "properties": {
        "card_id": { "$ref": "#/$defs/token" },
        "closed": { "type": "string", "maxLength": 256 },
        "permit": {
          "description": "Remote permission card. Readers that do not know it ignore it.",
          "type": "object",
          "required": ["session", "runner_id", "runner_fp", "nonce", "exp_ms", "req_sha256", "reissue", "agent", "tool", "text"],
          "properties": {
            "session": { "type": "string" },
            "runner_id": { "type": "string" },
            "runner_fp": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "exp_ms": { "type": "integer", "minimum": 0 },
            "req_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "reissue": { "type": "integer", "minimum": 0, "maximum": 255 },
            "agent": { "type": "string" },
            "tool": { "type": "string" },
            "text": { "type": "string" },
            "path": { "type": "string" },
            "reason": { "type": "string" },
            "from": { "type": "string" },
            "warning": { "type": "string" },
            "danger": { "type": "array", "items": { "type": "string" } },
            "always_label": { "type": "string" },
            "desktop_ok": { "type": "boolean", "default": false, "description": "True when a desktop may offer answer buttons. False or absent: the desktop shows \"Answer on your phone or in tmgr attach\"." }
          }
        },
        "spawn": {
          "description": "Owner approval card for a spawn proposal. Readers that do not know it ignore it.",
          "type": "object",
          "required": ["summary", "request", "nonce", "exp_ms", "target_id", "target_fp"],
          "properties": {
            "summary": { "type": "string", "maxLength": 2048 },
            "request": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "exp_ms": { "type": "integer", "minimum": 0 },
            "target_id": { "$ref": "#/$defs/token" },
            "target_fp": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "proposed_by": { "type": "string", "maxLength": 256 },
            "prompt": { "type": "string", "maxLength": 1000 }
          }
        }
      }
    },
    "user_turn": { "type": "boolean" },
    "poll": {
      "description": "Manager chat poll: an open card (questions) or its close (closed, picked). Only on a text message. Readers that do not know it show body_md.",
      "type": "object",
      "required": ["card_id", "session"],
      "properties": {
        "card_id": { "$ref": "#/$defs/token" },
        "session": { "$ref": "#/$defs/token" },
        "questions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["header", "question", "options"],
            "properties": {
              "header": { "type": "string", "maxLength": 60 },
              "question": { "type": "string", "minLength": 1, "maxLength": 500 },
              "multi_select": { "type": "boolean", "default": false },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["label"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                    "description": { "type": "string", "maxLength": 500, "default": "" },
                    "recommended": { "type": "boolean", "default": false }
                  }
                }
              }
            }
          }
        },
        "closed": { "type": "string", "maxLength": 300 },
        "picked": { "type": "string", "maxLength": 300 },
        "can_answer": { "type": "boolean", "default": true },
        "why_not": { "type": "string", "maxLength": 300 }
      }
    },
    "mention": {
      "description": "Runner-owned state of an @mention between chats. Never trust it from a relay, a follower or remote history. Unknown states decode to other.",
      "type": "object",
      "required": ["id", "target", "target_title", "state", "hop"],
      "properties": {
        "id": { "type": "string", "pattern": "^m_[0-9a-f]{32}$" },
        "target": {
          "type": "object",
          "required": ["kind", "machine"],
          "properties": {
            "kind": { "enum": ["manager", "session"] },
            "machine": { "$ref": "#/$defs/token" },
            "session": { "$ref": "#/$defs/token" }
          }
        },
        "target_title": { "type": "string" },
        "state": {
          "type": "string",
          "examples": ["queued", "sent", "answering", "answered", "busy", "offline", "timeout", "interrupted", "expired", "refused", "rate_limited", "cancelled"]
        },
        "hop": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "session_meta": {
      "description": "Runner-filled state of the session that wrote the message. Every field is optional.",
      "type": "object",
      "properties": {
        "context_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "agent": { "$ref": "#/$defs/token" },
        "model": { "type": "string", "pattern": "^[!-~]{1,128}$" }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
  }
}
