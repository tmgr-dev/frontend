{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/run.json",
  "title": "tmgr.v1 run event (one NDJSON line of log --follow --json)",
  "type": "object",
  "required": [
    "schema",
    "event",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "event": {
      "const": "run.updated"
    },
    "data": {
      "$ref": "#/$defs/run"
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "id",
        "agent",
        "status",
        "duration_s",
        "commits"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "task": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "ref",
                "title"
              ],
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "user_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_s": {
          "type": "integer"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sha",
              "message"
            ],
            "properties": {
              "sha": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "tests": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [],
              "properties": {
                "passed": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "failed": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "command": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "version": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
