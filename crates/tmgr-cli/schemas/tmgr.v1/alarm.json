{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/alarm.json",
  "title": "tmgr.v1 alarm",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "id",
        "status",
        "delivered_at",
        "acknowledged_at",
        "ack_channel",
        "call_status",
        "call_attempts",
        "call_attempts_made",
        "created_at",
        "timed_out"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "delivered_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "acknowledged_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ack_channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "call_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "call_attempts": {
          "type": [
            "integer",
            "null"
          ]
        },
        "call_attempts_made": {
          "type": [
            "integer",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
