{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/done.json",
  "title": "tmgr.v1 done",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "task",
        "timer",
        "status_change",
        "branch",
        "pr_url",
        "pr_source",
        "comment_posted"
      ],
      "properties": {
        "task": {
          "type": "object",
          "required": [
            "id",
            "ref",
            "title",
            "url",
            "status"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "ref": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/status"
            }
          }
        },
        "timer": {
          "type": "object",
          "required": [
            "stopped",
            "elapsed_s"
          ],
          "properties": {
            "stopped": {
              "type": "boolean"
            },
            "elapsed_s": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "status_change": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "$ref": "#/$defs/status"
            },
            "to": {
              "$ref": "#/$defs/status"
            }
          }
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_source": {
          "enum": [
            "gh",
            "compare",
            null
          ]
        },
        "comment_posted": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
