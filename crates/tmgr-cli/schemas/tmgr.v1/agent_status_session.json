{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/agent_status_session.json",
  "title": "tmgr.v1 agent status set / clear",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "session",
        "disabled"
      ],
      "properties": {
        "session": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/session"
            }
          ]
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "session_id",
        "state",
        "stale"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "task": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "key"
              ],
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "key": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "state": {
          "enum": [
            "working",
            "waiting",
            "blocked",
            "idle",
            "done",
            "exited",
            "unknown"
          ]
        },
        "state_since": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "host_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "stale": {
          "type": "boolean"
        }
      }
    }
  }
}
