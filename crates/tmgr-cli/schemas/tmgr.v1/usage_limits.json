{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/usage_limits.json",
  "title": "tmgr.v1 usage limits",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "limits"
      ],
      "properties": {
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tool",
              "account",
              "window",
              "used_pct",
              "resets_at",
              "resets_in_s",
              "plan",
              "source",
              "observed_at",
              "age_s"
            ],
            "properties": {
              "tool": {
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              "account": {
                "type": "string"
              },
              "window": {
                "type": "string"
              },
              "used_pct": {
                "type": "number"
              },
              "resets_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resets_in_s": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "plan": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "enum": [
                  "rollout",
                  "statusline"
                ]
              },
              "observed_at": {
                "type": "string"
              },
              "age_s": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
