{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/status.json",
  "title": "tmgr.v1 status",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "workspace",
        "active",
        "git",
        "today",
        "agents"
      ],
      "properties": {
        "workspace": {
          "type": "object",
          "required": [
            "id",
            "code",
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "code": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "active": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "task",
                "timer"
              ],
              "properties": {
                "task": {
                  "type": "object",
                  "required": [
                    "id",
                    "ref",
                    "title",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "ref": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "$ref": "#/$defs/status"
                    },
                    "category": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "title"
                          ],
                          "properties": {
                            "id": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "code": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "title": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "timer": {
                  "type": "object",
                  "required": [
                    "running"
                  ],
                  "properties": {
                    "running": {
                      "type": "boolean"
                    },
                    "started_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "seconds": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "git": {
          "type": [
            "object",
            "null"
          ]
        },
        "today": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "total_s"
              ],
              "properties": {
                "total_s": {
                  "type": "integer"
                },
                "human_s": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "agent_s": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "agents": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
