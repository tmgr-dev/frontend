{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/task.json",
  "title": "tmgr.v1 task show",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "task",
        "comments",
        "comments_total"
      ],
      "properties": {
        "task": {
          "type": "object",
          "required": [
            "id",
            "ref",
            "title",
            "status",
            "description_truncated"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "ref": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/status"
            },
            "category": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "title"
                  ],
                  "properties": {
                    "id": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "priority": {
              "type": [
                "string",
                "null"
              ]
            },
            "assignees": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "description_truncated": {
              "type": "boolean"
            },
            "estimate_s": {
              "type": [
                "integer",
                "null"
              ]
            },
            "tracked_s": {
              "type": [
                "integer",
                "null"
              ]
            },
            "created_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "message"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "author": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "message": {
                "type": "string"
              },
              "created_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "comments_total": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
