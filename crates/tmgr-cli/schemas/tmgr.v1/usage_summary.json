{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/usage_summary.json",
  "title": "tmgr.v1 usage summary",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "basis",
        "group_by",
        "windows",
        "linking",
        "task",
        "scan"
      ],
      "properties": {
        "basis": {
          "const": "api_equivalent"
        },
        "group_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "linking": {
          "$ref": "#/$defs/linking"
        },
        "task": {
          "$ref": "#/$defs/task"
        },
        "scan": {
          "$ref": "#/$defs/scan"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write_5m",
        "cache_write_1h",
        "reasoning"
      ],
      "properties": {
        "input": {
          "type": "integer"
        },
        "output": {
          "type": "integer"
        },
        "cache_read": {
          "type": "integer"
        },
        "cache_write_5m": {
          "type": "integer"
        },
        "cache_write_1h": {
          "type": "integer"
        },
        "reasoning": {
          "type": "integer"
        }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "group",
        "tokens",
        "tokens_total",
        "cost_usd",
        "events",
        "unpriced_events"
      ],
      "properties": {
        "group": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "name",
                  "hash"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "hash": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "tokens": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tokens"
            }
          ]
        },
        "tokens_total": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        },
        "events": {
          "type": "integer"
        },
        "unpriced_events": {
          "type": "integer"
        },
        "bucket": {
          "enum": [
            "task",
            "ambiguous",
            "unattributed"
          ]
        },
        "candidate_runs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "key",
        "label",
        "from",
        "to",
        "totals",
        "rows"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "totals": {
          "$ref": "#/$defs/row"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    },
    "linking": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "runs",
            "workspaces_ok",
            "workspaces_failed",
            "linked_events",
            "ambiguous_events",
            "unattributed_events"
          ],
          "properties": {
            "runs": {
              "type": "integer"
            },
            "workspaces_ok": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workspaces_failed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "linked_events": {
              "type": "integer"
            },
            "ambiguous_events": {
              "type": "integer"
            },
            "unattributed_events": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "task": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "ref",
            "runs",
            "link_methods"
          ],
          "properties": {
            "ref": {
              "type": "string"
            },
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "run",
                  "cost_usd",
                  "tokens_total",
                  "events",
                  "unpriced_events"
                ],
                "properties": {
                  "run": {
                    "type": "string"
                  },
                  "cost_usd": {
                    "type": "number"
                  },
                  "tokens_total": {
                    "type": "integer"
                  },
                  "events": {
                    "type": "integer"
                  },
                  "unpriced_events": {
                    "type": "integer"
                  }
                }
              }
            },
            "link_methods": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "scan": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "files",
            "events_new",
            "events_updated",
            "errors"
          ],
          "properties": {
            "files": {
              "type": "integer"
            },
            "events_new": {
              "type": "integer"
            },
            "events_updated": {
              "type": "integer"
            },
            "errors": {
              "type": "integer"
            },
            "bad_lines": {
              "type": "integer"
            },
            "skipped_before_floor": {
              "type": "integer"
            }
          }
        }
      ]
    }
  }
}
