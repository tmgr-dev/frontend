{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/usage_machine.json",
  "title": "tmgr.v1 usage machine",
  "type": "object",
  "required": ["schema", "ok", "data", "warnings"],
  "properties": {
    "schema": { "const": "tmgr.v1" },
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["status", "label", "on", "off", "sync"] },
        "machine_id": { "type": "string" },
        "label": { "type": "string" },
        "sync": { "type": "boolean" },
        "last_sync": { "type": ["string", "null"] },
        "skipped": { "type": "boolean" },
        "reason": { "type": "string" },
        "removed": { "type": "boolean" },
        "days": { "type": "integer" },
        "limits": { "type": "integer" },
        "server_days": { "type": "integer" },
        "server_limits": { "type": "integer" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
