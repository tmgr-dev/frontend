{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/whoami.json",
  "title": "tmgr.v1 whoami (also the result of login)",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "user",
        "server",
        "scopes",
        "credential_store"
      ],
      "properties": {
        "user": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "email": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "server": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_store": {
          "enum": [
            "keychain",
            "file"
          ]
        },
        "device_id": {}
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
