{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmgr.dev/schemas/tmgr.v1/stop.json",
  "title": "tmgr.v1 stop",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "data",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "tmgr.v1"
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "task",
        "stopped",
        "elapsed_s",
        "tracked_s"
      ],
      "properties": {
        "task": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "id",
            "ref",
            "title",
            "url"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "ref": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "stopped": {
          "type": "boolean"
        },
        "elapsed_s": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tracked_s": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    }
  }
}
