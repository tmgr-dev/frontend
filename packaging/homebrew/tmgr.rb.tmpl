class Tmgr < Formula
  desc "Command line tool for TMGR"
  homepage "https://tmgr.dev"
  version "@VERSION@"
  license "AGPL-3.0-only"

  on_macos do
    on_arm do
      url "https://github.com/tmgr-dev/frontend/releases/download/cli-v@VERSION@/tmgr-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/tmgr-dev/frontend/releases/download/cli-v@VERSION@/tmgr-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/tmgr-dev/frontend/releases/download/cli-v@VERSION@/tmgr-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "https://github.com/tmgr-dev/frontend/releases/download/cli-v@VERSION@/tmgr-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "tmgr"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/tmgr --version")
  end
end
