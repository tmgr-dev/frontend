{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TMGR",
  "version": "0.1.1",
  "identifier": "dev.tmgr.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "beforeBuildCommand": "npx vite build --mode desktop"
  },
  "app": {
    "windows": [
      {
        "title": "TMGR",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Task manager with time tracking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxODdEQzA0MEM0RUJBOUUKUldTZXVrNE1CTnlIWVE3K3E3KzR4bjdBNmtsclFVRTVDKy81dHFOOEhXc2syamRJVWxOYXJ2bnMK",
      "endpoints": [
        "https://github.com/tmgr-dev/frontend/releases/latest/download/latest.json"
      ]
    }
  }
}
