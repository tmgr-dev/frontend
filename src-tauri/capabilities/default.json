{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "quick-add"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "log:default",
    "updater:default",
    "process:allow-restart",
    "notification:default",
    "core:window:allow-hide",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "deep-link:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-size",
    "allow-capture-screenshot",
    "allow-capture-selection",
    "allow-take-capture",
    "allow-reveal-download",
    "allow-local-db-backup",
    "allow-local-db-execute",
    "allow-local-db-select",
    "allow-local-export-write",
    "allow-local-reveal",
    "allow-local-file-write",
    "allow-local-workspace-create",
    "allow-local-workspace-set-schema",
    "allow-local-workspaces-list",
    "allow-plugins-dev-list",
    "allow-plugins-dev-reveal",
    "allow-plugins-safe-mode",
    "allow-plugin-pick-file",
    "allow-plugin-fetch",
    "allow-plugin-notify",
    "allow-hide-quick-add",
    "allow-open-quick-add",
    "allow-take-quick-add",
    "allow-tray-update",
    "allow-dnd-update",
    "allow-plugin-page-put",
    "allow-plugin-window-open",
    "allow-plugin-window-reply",
    "allow-plugin-windows-close",
    "allow-plugin-github-release",
    "allow-plugin-catalog",
    "allow-plugin-catalog-refresh",
    "allow-plugin-install",
    "allow-plugins-installed-list",
    "allow-plugin-uninstall"
  ]
}
