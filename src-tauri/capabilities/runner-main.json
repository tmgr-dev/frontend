{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "runner-main",
  "description": "Agent runner control: main window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-runner-enabled",
    "allow-runner-set-enabled",
    "allow-runner-status",
    "allow-runner-profiles",
    "allow-runner-sessions",
    "allow-runner-start-run",
    "allow-runner-project-folder",
    "allow-runner-pick-folder",
    "allow-runner-halt",
    "allow-runner-open-terminal",
    "allow-runner-watch",
    "allow-runner-unwatch"
  ]
}
