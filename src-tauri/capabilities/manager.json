{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "manager",
	"description": "Manager chat window: only its own commands, inline Decisions cards, window basics and event listening.",
	"windows": ["manager"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"core:app:allow-version",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-internal-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"allow-manager-rooms",
		"allow-manager-history",
		"allow-manager-send",
		"allow-manager-search",
		"allow-manager-commands",
		"allow-manager-queued",
		"allow-manager-cancel",
		"allow-manager-mention-inject",
		"allow-manager-agent-models",
		"allow-manager-stop",
		"allow-manager-remove",
		"allow-manager-spawn-card",
		"allow-manager-spawn-decide",
		"allow-runner-status",
		"allow-manager-trust-state",
		"allow-manager-join-decide",
		"allow-manager-revoke-decide",
		"allow-manager-revoke",
		"allow-manager-confirm-device-kind",
		"allow-manager-reset-identity",
		"allow-manager-open-join-code",
		"allow-manager-close-join-code",
		"allow-manager-join-with-code",
		"allow-manager-pair-local-runner",
		"allow-manager-machines",
		"allow-manager-connect-followers",
		"allow-manager-followers",
		"allow-decisions-get",
		"allow-decisions-answer"
	]
}
